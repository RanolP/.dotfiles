{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(zellij run -n \"Claude Continue\"*)",
      "Edit(~/.claude-personal/projects/**/memory/**)",
      "Edit(~/.local/share/claude-projects/**/memory/**)",
      "Edit(~/.claude/projects/**/memory/**)",
      "Read(~/.claude-personal/projects/**/memory/**)",
      "Read(~/.local/share/claude-projects/**/memory/**)",
      "Read(~/.claude/projects/**/memory/**)"
    ],
    "deny": [
      "Bash(git commit *--no-verify*)",
      "Bash(git commit *-n *)",
      "Edit(**/.nanno-workers.json)",
      "Workflow",
      "ScheduleWakeup",
      "ReportFindings",
      "NotebookEdit",
      "DesignSync",
      "LSP",
      "CronCreate",
      "CronList",
      "CronDelete",
      "RemoteTrigger",
      "PushNotification",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Drive"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "supermemory@supermemory-plugins": false,
    "humanize-korean@im-not-ai": false,
    "claude-code-wakatime@wakatime": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "skillOverrides": {
    "auto-mode-setup": "off",
    "claude-api": "name-only",
    "dataviz": "name-only",
    "design": "name-only",
    "update-config": "name-only",
    "artifact-capabilities": "name-only",
    "schedule": "name-only",
    "run": "name-only",
    "loop": "name-only",
    "keybindings-help": "name-only",
    "fewer-permission-prompts": "name-only",
    "simplify": "name-only",
    "apology": "user-invocable-only",
    "시말서": "user-invocable-only",
    "one-domain": "user-invocable-only",
    "claude-hook-management": "user-invocable-only",
    "humanize-korean": "user-invocable-only",
    "humanize": "user-invocable-only",
    "humanize-redo": "user-invocable-only",
    "agents-sdk": "user-invocable-only",
    "cloudflare": "user-invocable-only",
    "cloudflare-email-service": "user-invocable-only",
    "cloudflare-one": "user-invocable-only",
    "cloudflare-one-migrations": "user-invocable-only",
    "durable-objects": "user-invocable-only",
    "sandbox-sdk": "user-invocable-only",
    "turnstile-spin": "user-invocable-only",
    "web-perf": "user-invocable-only",
    "workers-best-practices": "user-invocable-only",
    "wrangler": "user-invocable-only"
  },
  "model": "opus",
  "outputStyle": "concise-adhd-korean",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/wayseeker:~/.claude/mods/resources:~/.claude/mods/hetero-subagents:~/.claude/mods/ask-later:~/.claude/mods/request:~/.claude/mods/summation-panel:~/.claude/mods/bg-compact",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "GIT_PAGER": "cat",
    "GH_PAGER": "cat",
    "PAGER": "cat"
  },
  "effortLevel": "medium",
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "autoUpdates": false,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "disableDeepLinkRegistration": "disable",
  "feedbackSurveyRate": 0,
  "showClearContextOnPlanAccept": false,
  "skipWebFetchPreflight": true,
  "tui": "fullscreen",
  "viewMode": "focus",
  "worktree": {"symlinkDirectories": ["node_modules", "android", "ios"]},
  "preferredNotifChannel": "terminal_bell",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "extraKnownMarketplaces": {
    "supermemory-plugins": {
      "source": {
        "source": "github",
        "repo": "supermemoryai/claude-supermemory"
      }
    },
    "im-not-ai": {
      "source": {
        "source": "github",
        "repo": "epoko77-ai/im-not-ai"
      }
    },
    "wakatime": {
      "source": {
        "source": "github",
        "repo": "wakatime/claude-code-wakatime"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/apology-leak-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/bash-guards.py",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude-dir-edit-guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/baseline-lock-guard.py"
          }
        ]
      },
      {
        "matcher": "mcp__.*[Ss]lack.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/slack-subagent-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/rex-project-theme.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/mcp-auth-log.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/architect-rules.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/rex-project-theme.py"
          }
        ]
      }
    ]
  }
}
