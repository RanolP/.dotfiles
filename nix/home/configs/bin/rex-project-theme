#!/bin/sh

# Keep a Rex pane's project tint in sync without disturbing non-Rex shells.
if [ -z "${REX_BLOCK:-}" ]; then
  exit 0
fi

rex="/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex"
if [ ! -x "$rex" ]; then
  exit 0
fi

path=${1:-.}
if [ -d "$path" ]; then
  directory=$path
else
  directory=$(dirname "$path")
fi

# Same color as _folder-bg-color in nushell/config.nu (the Ghostty / Windows
# Terminal tint): sha256 of the repo root path picks one of the same dark
# Nord tints, so a repo keeps its color across terminals. Keep the two
# palettes and the override in step. Outside a repo, plain Nord nord0 returns.
root=$(git -C "$directory" rev-parse --show-toplevel 2>/dev/null) || root=
color="#2e3440"
if [ -n "$root" ]; then
  if [ "$root" = "$HOME/.dotfiles" ]; then
    color="#3b3042"
  else
    set -- 2e3b3b 3b382e 2e343f 3b2e2e 2e3b30 34303b 3b3630 303b38
    index=$(( 0x$(printf '%s' "$root" | shasum -a 256 | cut -c1-8) % $# + 1 ))
    eval "color=\"#\${$index}\""
  fi
fi

# The rest of the theme is Ghostty's built-in Nord (themes/Nord), sent on every
# call because Rex has no config-file theme. Palette 8 is the comment gray,
# raised from Nord's #596377 (2.0:1) to #7b88a1 (3.5:1), the same value as
# Ghostty's override and VS Code's comments. set_theme has no selection colors.
foreground="#d8dee9"
cursor="#eceff4"
palette='"0=#3b4252","1=#bf616a","2=#a3be8c","3=#ebcb8b","4=#81a1c1","5=#b48ead","6=#88c0d0","7=#e5e9f0","8=#7b88a1","9=#bf616a","10=#a3be8c","11=#ebcb8b","12=#81a1c1","13=#b48ead","14=#8fbcbb","15=#eceff4"'
theme="{\"background\":\"$color\",\"foreground\":\"$foreground\",\"cursor\":\"$cursor\",\"palette\":[$palette],\"scheme\":\"dark\"}"

state_key=$(printf '%s' "$REX_BLOCK" | cksum | awk '{print $1}')
state_file="${TMPDIR:-/tmp}/rex-project-theme-${state_key}"
last=
if [ -f "$state_file" ]; then
  IFS= read -r last < "$state_file" || true
  if [ "$theme" = "$last" ]; then
    exit 0
  fi
fi

if "$rex" --timeout 2s block call set_theme "$theme" >/dev/null 2>&1; then
  printf '%s\n' "$theme" > "$state_file"
fi

exit 0
