# Renderers behind xpkg/configs/install.nu. They take their target paths as
# arguments so the output can be rendered into a scratch directory and checked
# without touching the live config.

def dotfiles [...parts: string] { $nu.home-path | path join '.dotfiles' ...$parts }

# nix/home/programs/aliases.nix is a flat attrset of `name = "value";` lines.
# Anything else (a nix expression, an escape, an interpolation) fails loudly
# instead of being dropped.
def render-aliases [] {
    let src = (dotfiles nix home programs aliases.nix)
    open --raw $src
    | lines
    | enumerate
    | where {|l| ($l.item | str trim) not-in ['' '{' '}'] and not ($l.item | str trim | str starts-with '#') }
    | each {|l|
        let m = ($l.item | parse --regex '^\s*(?<name>[A-Za-z0-9_.-]+)\s*=\s*"(?<value>[^"\\$]*)"\s*;\s*$')
        if ($m | is-empty) {
            error make { msg: $"($src):($l.index + 1): not a `name = \"value\";` alias line: ($l.item)" }
        }
        $"alias ($m.0.name) = ($m.0.value)"
    }
    | str join "\n"
}

def header [sources: list<string>] {
    [
        '# GENERATED by xpkg/configs/install.nu -- do not edit; edit the sources and re-run `rebuild`.'
        ...($sources | each {|s| $"#   ($s)" })
    ] | str join "\n"
}

# Writes env.nu = Windows overlay + shared env.common.nu, and config.nu =
# Windows overlay + shared config.nu + aliases.nix. The overlay env runs first
# so its PATH conversion and HOME fallback are in place for the shared env.
export def nushell-config [env_target: path, config_target: path] {
    let env_text = [
        (header ['xpkg/configs/nushell/env.nu' 'nix/home/configs/nushell/env.common.nu'])
        (open --raw (dotfiles xpkg configs nushell env.nu))
        (open --raw (dotfiles nix home configs nushell env.common.nu))
    ] | str join "\n"

    # nix-your-shell's output exists only on nix hosts, and a missing `source`
    # target is a parse error.
    let shared_config = (
        open --raw (dotfiles nix home configs nushell config.nu)
        | lines
        | where {|l| ($l | str trim) != 'source ~/.cache/nix-your-shell.nu' }
        | str join "\n"
    )
    let config_text = [
        (header ['xpkg/configs/nushell/config.nu' 'nix/home/configs/nushell/config.nu' 'nix/home/programs/aliases.nix'])
        (open --raw (dotfiles xpkg configs nushell config.nu))
        $shared_config
        (render-aliases)
    ] | str join "\n"

    # The targets may still be hardlinks into this repo from the old install;
    # removing first keeps `save` from writing through into the sources.
    for t in [[path text]; [$env_target $env_text] [$config_target $config_text]] {
        rm -f $t.path
        $"($t.text)\n" | save -f $t.path
    }
}

# Merges the shared nix source (single source of truth for tool versions) with
# the Windows overlay; overlay keys win. An overlay tool given as a record
# without `version` keeps the shared pin, so swapping in a Windows binary does
# not unpin it.
export def mise-config [target: path] {
    let shared = (open (dotfiles nix home mise-global.toml))
    let overlay = (open (dotfiles xpkg configs mise config.toml))
    let shared_tools = ($shared.tools? | default {})
    let overlay_tools = ($overlay.tools? | default {} | items {|name, spec|
        let pin = ($shared_tools | get -i $name)
        let pinned = if ($pin | describe | str starts-with 'record') { $pin.version? } else { $pin }
        let spec = if ($spec | describe | str starts-with 'record') and ($spec.version? == null) and ($pinned != null) {
            {version: $pinned} | merge $spec
        } else { $spec }
        {($name): $spec}
    } | reduce -f {} {|it, acc| $acc | merge $it })
    mkdir ($target | path dirname)
    {
        tools: ($shared_tools | merge $overlay_tools)
        settings: ($shared.settings? | default {} | merge ($overlay.settings? | default {}))
    } | save -f $target
}
